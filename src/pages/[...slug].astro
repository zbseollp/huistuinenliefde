---
import { getCollection, render } from 'astro:content';
import { existsSync } from 'node:fs';
import { fileURLToPath } from 'node:url';
import path from 'node:path';
import BlogPostLayout from '../layouts/BlogPostLayout.astro';
import PageLayout from '../layouts/PageLayout.astro';
import ProductPageLayout from '../layouts/ProductPageLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const productHtmlDir = fileURLToPath(new URL('../content/product-html', import.meta.url));

export async function getStaticPaths() {
  const blogEntries = await getCollection('blog');
  const pageEntries = await getCollection('pages');

  const blogPaths = blogEntries.map((entry) => ({
    params: { slug: entry.id },
    props: { type: 'blog' as const, entry },
  }));

  const pagePaths = pageEntries.map((entry) => ({
    params: { slug: entry.id },
    props: { type: 'page' as const, entry },
  }));

  return [...blogPaths, ...pagePaths];
}

const { type, entry } = Astro.props;
const { Content } = await render(entry);
const productHtmlPath = path.join(productHtmlDir, `${entry.id}.html`);
const isProductPage = existsSync(productHtmlPath) || entry.data.pageType === 'product';
---
{type === 'blog' ? (
  <BlogPostLayout entry={entry}>
    <Header slot="header" />
    <Content />
    <Footer slot="footer" />
  </BlogPostLayout>
) : isProductPage ? (
  <ProductPageLayout entry={entry}>
    <Header slot="header" />
    <Content />
    <Footer slot="footer" />
  </ProductPageLayout>
) : (
  <PageLayout entry={entry}>
    <Header slot="header" />
    <Content />
    <Footer slot="footer" />
  </PageLayout>
)}
