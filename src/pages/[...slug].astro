---
import { getCollection, render } from 'astro:content';
import BlogPostLayout from '../layouts/BlogPostLayout.astro';
import PageLayout from '../layouts/PageLayout.astro';
import ProductPageLayout from '../layouts/ProductPageLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const productHtmlModules = import.meta.glob('../content/product-html/*.html', {
  query: '?raw',
  import: 'default',
  eager: true,
});

export async function getStaticPaths() {
  const blogEntries = await getCollection('blog');
  const pageEntries = await getCollection('pages');

  const blogPaths = blogEntries.map((entry) => ({
    params: { slug: entry.id },
    props: { type: 'blog' as const, entry },
  }));

  const pagePaths = pageEntries.map((entry) => ({
    params: { slug: entry.id },
    props: { type: 'page' as const, entry },
  }));

  return [...blogPaths, ...pagePaths];
}

const { type, entry } = Astro.props;
const { Content } = await render(entry);
const hasProductHtml = `../content/product-html/${entry.id}.html` in productHtmlModules;
const isProductPage = hasProductHtml || entry.data.pageType === 'product';
---
{type === 'blog' ? (
  <BlogPostLayout entry={entry}>
    <Header slot="header" />
    <Content />
    <Footer slot="footer" />
  </BlogPostLayout>
) : isProductPage ? (
  <ProductPageLayout entry={entry}>
    <Header slot="header" />
    <Content />
    <Footer slot="footer" />
  </ProductPageLayout>
) : (
  <PageLayout entry={entry}>
    <Header slot="header" />
    <Content />
    <Footer slot="footer" />
  </PageLayout>
)}
