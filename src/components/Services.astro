---
import { categorySections } from '../data/categories';
---
<section class="services section">
  <div class="container">
    <div class="section-header section-header--center">
      <h2>Categorieën</h2>
      <p>VInd hier onze categorieën en laat je inspireren zodat jij je huis en tuin kan omtoveren tot jouw droom thuis.</p>
    </div>

    <div class="services__grid">
      {categorySections.map((category) => (
        <article class="services__card">
          <div class="services__card-image">
            <img src={category.image} alt={category.imageAlt} width="640" height="427" loading="lazy" />
          </div>
          <div class="services__card-body">
            <h3 class="services__card-title">{category.title}</h3>
            <div class="services__links">
              {category.links.map((link) => (
                <a href={link.href}>{link.label}</a>
              ))}
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .services {
    padding-top: 72px;
  }

  .services__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0;
  }

  .services__card {
    background: var(--color-secondary);
    margin: 10px 10px 32px;
  }

  .services__card-image img {
    width: 100%;
    height: clamp(150px, 25vw, 200px);
    object-fit: cover;
    display: block;
  }

  .services__card-body {
    padding: 1rem 0 0;
  }

  .services__card-title {
    font-family: var(--font-body);
    font-size: 0.875rem;
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    color: var(--color-accent);
    margin: 0 0 0.75rem;
  }

  .services__links {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .services__links a {
    font-size: 1rem;
    line-height: 1.7;
    color: #d63384;
    text-decoration: underline;
    text-decoration-color: transparent;
    text-underline-offset: 2px;
    transition: text-decoration-color var(--transition);
  }

  .services__links a:hover {
    text-decoration-color: #d63384;
  }

  @media (min-width: 600px) {
    .services__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 1024px) {
    .services__grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
