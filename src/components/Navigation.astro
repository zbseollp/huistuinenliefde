---
import type { NavItem } from '../data/navigation';

interface Props {
  items: NavItem[];
  currentPath: string;
}

const { items, currentPath } = Astro.props;

function isActive(href: string): boolean {
  if (href === '/') return currentPath === '/';
  return currentPath.startsWith(href.replace(/\/$/, ''));
}
---
<nav class="nav" aria-label="Hoofdnavigatie">
  <ul class="nav__list">
    {items.map((item) => (
      <li class:list={['nav-item', { 'nav-item--has-children': item.children }]}>
        <a
          href={item.href}
          class:list={['nav-link', { 'nav-link--active': isActive(item.href) }]}
          aria-current={isActive(item.href) ? 'page' : undefined}
        >
          {item.label}
          {item.children && (
            <svg class="nav-link__caret" width="10" height="10" viewBox="0 0 320 512" fill="currentColor" aria-hidden="true"><path d="M137.4 374.6c12.5 12.5 32.8 12.5 45.3 0l128-128c9.2-9.2 11.9-22.9 6.9-34.9S300.9 192 288 192L32 192c-12.9 0-24.6 7.8-29.6 19.8s-2.2 25.7 6.9 34.9l128 128z"/></svg>
          )}
        </a>
        {item.children && (
          <ul class="nav-submenu">
            {item.children.map((child) => (
              <li>
                <a href={child.href} class="nav-submenu__link">{child.label}</a>
              </li>
            ))}
          </ul>
        )}
      </li>
    ))}
  </ul>
</nav>

<style>
  .nav__list {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .nav-link {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.875rem 1rem;
    font-family: var(--font-body);
    font-size: 0.875rem;
    font-weight: 400;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    color: var(--color-text);
    transition: color var(--transition);
  }

  .nav-link:hover,
  .nav-link--active {
    color: var(--color-text);
  }

  .nav-link__caret {
    flex-shrink: 0;
    margin-left: 0.125rem;
    opacity: 0.85;
    transition: transform var(--transition);
  }

  .nav-item--expanded .nav-link__caret {
    transform: rotate(180deg);
  }

  .nav-submenu {
    display: none;
    padding: 0.5rem 0 0.5rem 1rem;
    background: rgba(0, 0, 0, 0.02);
  }

  .nav-item--expanded .nav-submenu {
    display: block;
  }

  .nav-submenu__link {
    display: block;
    padding: 0.5rem 1rem;
    font-size: 0.875rem;
    color: var(--color-text);
    transition: color var(--transition), padding-left var(--transition);
  }

  .nav-submenu__link:hover {
    color: var(--color-accent);
    padding-left: 1.25rem;
  }

  @media (max-width: 1023px) {
    .nav {
      position: fixed;
      top: 65px;
      left: 0;
      right: 0;
      bottom: 0;
      background: var(--color-secondary);
      padding: 1rem;
      transform: translateX(100%);
      transition: transform var(--transition);
      overflow-y: auto;
      z-index: 99;
    }

    .nav--open {
      transform: translateX(0);
    }
  }

  @media (min-width: 1024px) {
    .nav__list {
      flex-direction: row;
      align-items: center;
      gap: 0.25rem;
    }

    .nav-link {
      padding: 0.5rem 1rem;
    }

    .nav__list {
      justify-content: center;
    }

    .nav-item {
      position: relative;
    }

    .nav-item--has-children:hover .nav-submenu,
    .nav-item--has-children:focus-within .nav-submenu {
      display: block;
    }

    .nav-submenu {
      position: absolute;
      top: 100%;
      left: 0;
      min-width: 240px;
      padding: 0.75rem 0;
      background: var(--color-secondary);
      border: 1px solid var(--color-border);
      border-radius: var(--card-radius);
      box-shadow: var(--shadow-md);
      z-index: 1001;
    }

    .nav-item--expanded .nav-submenu {
      display: none;
    }

    .nav-item--has-children:hover .nav-submenu {
      display: block;
    }
  }
</style>
