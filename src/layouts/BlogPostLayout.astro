---
import type { CollectionEntry } from 'astro:content';
import { resolveFeaturedImage } from '../lib/blogImages';
import BaseLayout from './BaseLayout.astro';

interface Props {
  entry: CollectionEntry<'blog'>;
}

const { entry } = Astro.props;

function formatDate(date: Date): string {
  const months = [
    'januari', 'februari', 'maart', 'april', 'mei', 'juni',
    'juli', 'augustus', 'september', 'oktober', 'november', 'december',
  ];
  return `${months[date.getMonth()]} ${date.getDate()}, ${date.getFullYear()}`;
}

const featuredImage =
  resolveFeaturedImage(entry.data, entry.body) ?? '/images/blog/terras-tuin.jpg';
const imageAlt = entry.data.imageAlt ?? entry.data.title;
---
<BaseLayout title={entry.data.title} description={entry.data.description} image={featuredImage}>
  <slot name="header" />

  <article class="blog-post">
    <header class="blog-post__header section--sm">
      <div class="container reveal">
        <a href="/blog/" class="blog-post__back">&larr; Terug naar blog</a>
        <h1>{entry.data.title}</h1>
        <div class="blog-post__meta">
          {entry.data.author && <span class="blog-post__author">{entry.data.author}</span>}
          <time class="blog-post__date" datetime={entry.data.pubDate.toISOString()}>
            {formatDate(entry.data.pubDate)}
          </time>
        </div>
        {entry.data.categories && entry.data.categories.length > 0 && (
          <ul class="blog-post__categories">
            {entry.data.categories.map((category) => (
              <li>{category}</li>
            ))}
          </ul>
        )}
      </div>
    </header>

    <div class="blog-post__featured container reveal">
      <img
        src={featuredImage}
        alt={imageAlt}
        class="blog-post__image"
        width="1280"
        height="853"
        loading="eager"
      />
    </div>

    <div class="blog-post__content section">
      <div class="container reveal">
        <div class="blog-post__body">
          <slot />
        </div>
      </div>
    </div>
  </article>

  <slot name="footer" />
</BaseLayout>

<style>
  .blog-post__header {
    background: var(--color-secondary);
    border-bottom: 1px solid var(--color-border);
  }

  .blog-post__back {
    display: inline-block;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-accent);
    margin-bottom: 1.5rem;
    transition: color var(--transition);
  }

  .blog-post__back:hover {
    color: #245a31;
  }

  .blog-post__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.25rem;
    align-items: center;
    margin-top: 0.75rem;
  }

  .blog-post__author {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-primary);
  }

  .blog-post__date {
    font-size: 0.875rem;
    color: var(--color-muted);
  }

  .blog-post__categories {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 1rem 0 0;
    padding: 0;
    list-style: none;
  }

  .blog-post__categories li {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--color-accent);
    background: rgba(44, 108, 58, 0.08);
    padding: 0.25rem 0.625rem;
    border-radius: var(--card-radius);
  }

  .blog-post__featured {
    padding-top: clamp(1.5rem, 4vw, 2.5rem);
  }

  .blog-post__image {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    border-radius: var(--card-radius);
    box-shadow: var(--shadow-md);
  }

  .blog-post__body {
    max-width: 720px;
    margin-inline: auto;
    font-size: clamp(1rem, 2vw, 1.0625rem);
    line-height: 1.8;
  }

  .blog-post__body :global(h2),
  .blog-post__body :global(h3),
  .blog-post__body :global(h4) {
    margin-top: 2rem;
    margin-bottom: 0.75rem;
  }

  .blog-post__body :global(p) {
    margin-bottom: 1.25rem;
  }

  .blog-post__body :global(img) {
    max-width: 100%;
    height: auto;
    border-radius: var(--card-radius);
    margin: 1.5rem 0;
  }

  .blog-post__body :global(a) {
    color: var(--color-accent);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .blog-post__body :global(ul),
  .blog-post__body :global(ol) {
    margin: 0 0 1.25rem 1.25rem;
    padding-left: 1rem;
  }

  .blog-post__body :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 1.5rem 0;
    font-size: 0.9375rem;
  }

  .blog-post__body :global(td),
  .blog-post__body :global(th) {
    border: 1px solid var(--color-border);
    padding: 0.625rem 0.75rem;
    text-align: left;
  }
</style>
