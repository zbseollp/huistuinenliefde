---
import type { CollectionEntry } from 'astro:content';
import { readFileSync, existsSync } from 'node:fs';
import { fileURLToPath } from 'node:url';
import path from 'node:path';
import BaseLayout from './BaseLayout.astro';

interface Props {
  entry: CollectionEntry<'pages'>;
}

const { entry } = Astro.props;

const htmlPath = path.join(
  fileURLToPath(new URL('../content/product-html', import.meta.url)),
  `${entry.id}.html`,
);

const htmlContent = existsSync(htmlPath) ? readFileSync(htmlPath, 'utf-8') : '';
---
<BaseLayout title={entry.data.title} description={entry.data.description}>
  <slot name="header" />

  <article class="product-page">
    <div class="product-page__inner container">
      {htmlContent ? (
        <div class="product-page__content elementor-content" set:html={htmlContent} />
      ) : (
        <div class="product-page__fallback">
          <slot />
        </div>
      )}
    </div>
  </article>

  <slot name="footer" />
</BaseLayout>

<style is:global>
  .product-page {
    padding: clamp(2rem, 4vw, 3.5rem) 0 clamp(3rem, 6vw, 5rem);
    background: var(--color-secondary);
    position: relative;
    z-index: 1;
  }

  .product-page__inner {
    max-width: var(--container-max);
  }

  .product-page__content {
    width: 100%;
  }

  /* Elementor layout helpers */
  .elementor-content .elementor-section {
    margin-bottom: 0;
  }

  .elementor-content .elementor-container {
    display: flex;
    flex-wrap: wrap;
    width: 100%;
    max-width: 100%;
    margin-inline: auto;
  }

  .elementor-content .elementor-column {
    min-height: 1px;
  }

  .elementor-content .elementor-col-50 {
    width: 100%;
  }

  .elementor-content .elementor-col-66,
  .elementor-content .elementor-col-70 {
    width: 100%;
  }

  .elementor-content .elementor-col-33,
  .elementor-content .elementor-col-30 {
    width: 100%;
  }

  @media (min-width: 768px) {
    .elementor-content .elementor-col-50 {
      width: 50%;
    }

    .elementor-content .elementor-col-66 {
      width: 66.666%;
    }

    .elementor-content .elementor-col-70 {
      width: 70%;
    }

    .elementor-content .elementor-col-33 {
      width: 33.333%;
    }

    .elementor-content .elementor-col-30 {
      width: 30%;
    }
  }

  .elementor-content .elementor-widget-wrap {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .elementor-content .elementor-heading-title {
    font-family: var(--font-heading);
    color: var(--color-primary);
    line-height: 1.25;
    margin: 0 0 0.75rem;
  }

  .elementor-content h1.elementor-heading-title {
    font-size: clamp(1.75rem, 3.5vw, 2.25rem);
    font-weight: 600;
    margin-bottom: 1rem;
  }

  .elementor-content h2.elementor-heading-title {
    font-size: clamp(1.375rem, 2.5vw, 1.75rem);
    font-weight: 600;
    margin-top: 1.5rem;
  }

  .elementor-content h4.elementor-heading-title {
    font-size: 1.125rem;
    font-weight: 600;
  }

  .elementor-content .elementor-widget-text-editor,
  .elementor-content .elementor-widget-text-editor p {
    font-size: 1rem;
    line-height: 1.8;
    color: var(--color-text);
  }

  .elementor-content .elementor-widget-text-editor p {
    margin: 0 0 1rem;
  }

  .elementor-content .elementor-widget-text-editor a {
    color: #d63384;
    text-decoration: none;
  }

  .elementor-content .elementor-widget-text-editor a:hover {
    text-decoration: underline;
  }

  .elementor-content .elementor-widget-text-editor strong {
    font-weight: 700;
  }

  .elementor-content .elementor-widget-image img,
  .elementor-content .elementor-heading-title img {
    max-width: 100%;
    height: auto;
    display: block;
    margin: 0 auto;
  }

  .elementor-content .elementor-widget-image img {
    max-width: 400px;
  }

  .elementor-content .elementor-divider-separator {
    display: block;
    border-top: 1px solid var(--color-border);
    margin: 1.5rem 0;
  }

  .elementor-content .elementor-button-wrapper {
    margin: 1rem 0 1.5rem;
  }

  .elementor-content .elementor-button {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: var(--color-accent);
    color: var(--color-secondary);
    font-family: var(--font-body);
    font-size: 0.9375rem;
    font-weight: 600;
    padding: 0.875rem 1.5rem;
    border-radius: 3px;
    border: none;
    text-decoration: none;
    transition: background var(--transition), transform var(--transition);
  }

  .elementor-content .elementor-button:hover {
    background: #245a31;
    transform: translateY(-1px);
  }

  .elementor-content .elementor-button-content-wrapper {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .elementor-content .elementor-button-icon svg {
    width: 1em;
    height: 1em;
    fill: currentColor;
  }

  /* Table of contents */
  .elementor-content .elementor-toc__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.75rem 1rem;
    border: 1px solid var(--color-border);
    border-bottom: none;
    background: #fafafa;
  }

  .elementor-content .elementor-toc__header-title {
    font-size: 1rem;
    font-weight: 600;
    margin: 0;
  }

  .elementor-content .elementor-toc__body {
    border: 1px solid var(--color-border);
    padding: 1rem 1.25rem;
    background: #fff;
  }

  .elementor-content .elementor-toc__spinner-container {
    display: none;
  }

  .elementor-content .elementor-toc__toggle-button {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 1.5rem;
    height: 1.5rem;
    cursor: pointer;
    color: var(--color-text);
    font-size: 0.75rem;
  }

  .elementor-content .elementor-toc__toggle-button--collapse {
    display: none;
  }

  .elementor-content .elementor-toc--collapsed .elementor-toc__toggle-button--expand {
    display: none;
  }

  .elementor-content .elementor-toc--collapsed .elementor-toc__toggle-button--collapse {
    display: flex;
  }

  .elementor-content .elementor-toc--collapsed .elementor-toc__body {
    display: none;
  }

  .elementor-content .elementor-toc__list-wrapper {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .elementor-content .elementor-toc__list-item {
    margin-bottom: 0.625rem;
  }

  .elementor-content .elementor-toc__list-item-text-wrapper {
    display: block;
  }

  .elementor-content .elementor-toc__list-item-text {
    color: var(--color-text);
    font-size: 0.875rem;
    line-height: 1.5;
    text-decoration: none;
    transition: color var(--transition);
  }

  .elementor-content .elementor-toc__list-item-text:hover {
    color: var(--color-accent);
  }

  .elementor-content .elementor-toc__list-item .elementor-toc__list-wrapper {
    margin-top: 0.5rem;
    padding-left: 1rem;
  }

  /* FAQ accordion */
  .elementor-content .elementor-accordion-item {
    border: 1px solid var(--color-border);
    margin-bottom: -1px;
  }

  .elementor-content .elementor-tab-title {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1rem 1.25rem;
    font-weight: 600;
    font-size: 0.9375rem;
    cursor: pointer;
    background: #fafafa;
  }

  .elementor-content .elementor-tab-content {
    padding: 1rem 1.25rem;
    border-top: 1px solid var(--color-border);
    font-size: 0.9375rem;
    line-height: 1.7;
  }

  .elementor-content .elementor-accordion-icon {
    font-size: 1rem;
    color: var(--color-accent);
  }

  /* Author box */
  .elementor-content .elementor-author-box {
    display: flex;
    gap: 1.25rem;
    align-items: flex-start;
    padding: 1.5rem;
    border: 1px solid var(--color-border);
    margin-top: 2rem;
    background: #fafafa;
  }

  .elementor-content .elementor-author-box__avatar img {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    object-fit: cover;
  }

  .elementor-content .elementor-author-box__name {
    font-weight: 700;
    margin-bottom: 0.5rem;
  }

  .elementor-content .elementor-author-box__bio {
    font-size: 0.9375rem;
    line-height: 1.7;
    color: var(--color-text);
  }

  /* Two-column intro + TOC row */
  .elementor-content .elementor-top-section .elementor-container {
    gap: 2rem;
  }

  .elementor-content .elementor-top-column {
    width: 100%;
  }

  @media (min-width: 992px) {
    .elementor-content .elementor-top-section .elementor-col-50:first-child {
      width: 58%;
    }

    .elementor-content .elementor-top-section .elementor-col-50:last-child {
      width: 38%;
    }

    .elementor-content .elementor-widget-table-of-contents {
      position: sticky;
      top: 5.5rem;
      align-self: flex-start;
      z-index: 2;
      max-height: calc(100vh - 6.5rem);
      overflow: auto;
    }
  }

  @media (min-width: 992px) {
    .elementor-content .elementor-inner-section .elementor-container {
      align-items: flex-start;
    }

    .elementor-content .elementor-inner-section .elementor-col-50:first-child {
      padding-right: 1rem;
    }

    .elementor-content .elementor-inner-section .elementor-col-50:last-child {
      padding-left: 1rem;
    }
  }

  .elementor-content .elementor-hidden-desktop,
  .elementor-content .elementor-hidden-tablet,
  .elementor-content .elementor-hidden-mobile {
    display: revert;
  }

  .elementor-content .elementor-accordion .elementor-tab-content {
    display: none;
  }

  .elementor-content .elementor-accordion .elementor-accordion-item.active .elementor-tab-content {
    display: block;
  }
</style>

<script>
  function slugifyHeading(text: string, index: number): string {
    const base = text
      .toLowerCase()
      .normalize('NFD')
      .replace(/[\u0300-\u036f]/g, '')
      .replace(/[^a-z0-9]+/g, '-')
      .replace(/^-|-$/g, '');
    return base ? `${base}-${index}` : `section-${index}`;
  }

  function buildTableOfContents(root: Element) {
    root.querySelectorAll('.elementor-widget-table-of-contents').forEach((widget) => {
      const body = widget.querySelector('.elementor-toc__body');
      if (!body) return;

      const headings = Array.from(
        root.querySelectorAll(
          'h2.elementor-heading-title, h3.elementor-heading-title, h4.elementor-heading-title, h5.elementor-heading-title, h6.elementor-heading-title',
        ),
      ).filter((heading) => !widget.contains(heading) && heading.textContent?.trim());

      if (headings.length === 0) return;

      const usedIds = new Set<string>();
      headings.forEach((heading, index) => {
        if (heading.id) return;
        let id = slugifyHeading(heading.textContent?.trim() ?? '', index);
        while (usedIds.has(id) || document.getElementById(id)) {
          id = `${id}-${index}`;
        }
        heading.id = id;
        usedIds.add(id);
      });

      const list = document.createElement('ol');
      list.className = 'elementor-toc__list-wrapper';

      headings.forEach((heading) => {
        const item = document.createElement('li');
        item.className = 'elementor-toc__list-item';

        const wrapper = document.createElement('div');
        wrapper.className = 'elementor-toc__list-item-text-wrapper';

        const link = document.createElement('a');
        link.className = 'elementor-toc__list-item-text';
        link.href = `#${heading.id}`;
        link.textContent = heading.textContent?.trim() ?? '';

        wrapper.appendChild(link);
        item.appendChild(wrapper);
        list.appendChild(item);
      });

      body.innerHTML = '';
      body.appendChild(list);

      widget.querySelectorAll('.elementor-toc__toggle-button').forEach((button) => {
        button.addEventListener('click', () => {
          widget.classList.toggle('elementor-toc--collapsed');
          const expanded = !widget.classList.contains('elementor-toc--collapsed');
          widget.querySelectorAll('.elementor-toc__toggle-button').forEach((btn) => {
            btn.setAttribute('aria-expanded', String(expanded));
          });
        });
      });
    });
  }

  document.querySelectorAll('.product-page__content').forEach((root) => {
    buildTableOfContents(root);
  });

  document.querySelectorAll('.elementor-accordion .elementor-tab-title').forEach((title) => {
    title.addEventListener('click', () => {
      const item = title.closest('.elementor-accordion-item');
      if (!item) return;
      const panel = item.closest('.elementor-accordion');
      panel?.querySelectorAll('.elementor-accordion-item.active').forEach((open) => {
        if (open !== item) open.classList.remove('active');
      });
      item.classList.toggle('active');
    });
  });
</script>
